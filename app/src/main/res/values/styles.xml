<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="key_height">46dp</dimen>
    <dimen name="candidate_height">44dp</dimen>

    <!-- 按键通用样式：去掉 Material 默认最小尺寸与阴影，保证 4 行键盘在 Android 5.0+ 高度一致 -->
    <style name="KeyText" parent="Widget.AppCompat.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/key_fg</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minEms">0</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CardTitle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardBody" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
