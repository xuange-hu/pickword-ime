<?xml version="1.0" encoding="utf-8"?>
<!-- 单个候选（译词在右侧版本）：词 + 英文 + 收藏星标，横向排列 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_candidate"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="54dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/candidate_word"
        style="@style/TextAppearance.Candidate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <TextView
        android:id="@+id/candidate_gloss"
        style="@style/TextAppearance.Gloss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="96dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/candidate_star"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:text="☆"
        android:textColor="@color/star"
        android:textSize="14sp" />
</LinearLayout>
