<?xml version="1.0" encoding="utf-8"?>
<!-- 单个候选：上方是词与收藏星标，下方是英文译词 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_candidate"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minWidth="54dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/candidate_word"
            style="@style/TextAppearance.Candidate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <TextView
            android:id="@+id/candidate_star"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/star"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/candidate_gloss"
        style="@style/TextAppearance.Gloss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="110dp"
        android:singleLine="true" />
</LinearLayout>
