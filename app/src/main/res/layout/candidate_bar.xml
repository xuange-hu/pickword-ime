<?xml version="1.0" encoding="utf-8"?>
<!-- 候选栏（独立布局：既内嵌在键盘上方，也可作为悬浮候选单独使用） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/candidate_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/composition"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center_vertical|start"
        android:maxEms="7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:text="@string/candidates_empty"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/candidate_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/candidate_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/btn_more"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:tag="special"
        android:text="⋁"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_emoji"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:tag="special"
        android:text="☺"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_phrase"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:tag="special"
        android:text="≡"
        android:textSize="18sp" />
</LinearLayout>
