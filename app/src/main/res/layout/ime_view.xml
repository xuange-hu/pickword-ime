<?xml version="1.0" encoding="utf-8"?>
<!-- 输入法主视图：背景层 + 内容层（候选栏 + 可切换面板） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 自定义背景图（用户在设置里选，可调整不透明度） -->
    <ImageView
        android:id="@+id/keyboard_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:contentDescription="@string/ime_label"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ime_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 内嵌候选栏；开启“悬浮候选”后隐藏，改由系统候选视图承载 -->
        <include
            android:id="@+id/candidate_bar"
            layout="@layout/candidate_bar" />

        <View
            android:id="@+id/ime_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider" />

        <!-- 面板容器：键盘 / 表情 / 常用语 / 剪贴板 / 更多候选 -->
        <FrameLayout
            android:id="@+id/panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
