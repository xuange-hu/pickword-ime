<?xml version="1.0" encoding="utf-8"?>
<!-- 拼音全键盘：可选数字行 + 26 键 + 符号/表情/中英切换 + 空格/换行/删除
     说明：tag="row" 的行由 Skinner 按设置改高度；tag="special" 的键用次要配色 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_qwerty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingBottom="3dp">

    <!-- 数字行（可在设置中开关，默认关闭） -->
    <LinearLayout
        android:id="@+id/row_number"
        android:layout_width="match_parent"
        android:layout_height="@dimen/key_height"
        android:orientation="horizontal"
        android:tag="row"
        android:visibility="gone">

        <include layout="@layout/key_item" android:id="@+id/n_1" />
        <include layout="@layout/key_item" android:id="@+id/n_2" />
        <include layout="@layout/key_item" android:id="@+id/n_3" />
        <include layout="@layout/key_item" android:id="@+id/n_4" />
        <include layout="@layout/key_item" android:id="@+id/n_5" />
        <include layout="@layout/key_item" android:id="@+id/n_6" />
        <include layout="@layout/key_item" android:id="@+id/n_7" />
        <include layout="@layout/key_item" android:id="@+id/n_8" />
        <include layout="@layout/key_item" android:id="@+id/n_9" />
        <include layout="@layout/key_item" android:id="@+id/n_0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/key_height"
        android:orientation="horizontal"
        android:tag="row">

        <include layout="@layout/key_letter" android:id="@+id/k_q" />
        <include layout="@layout/key_letter" android:id="@+id/k_w" />
        <include layout="@layout/key_letter" android:id="@+id/k_e" />
        <include layout="@layout/key_letter" android:id="@+id/k_r" />
        <include layout="@layout/key_letter" android:id="@+id/k_t" />
        <include layout="@layout/key_letter" android:id="@+id/k_y" />
        <include layout="@layout/key_letter" android:id="@+id/k_u" />
        <include layout="@layout/key_letter" android:id="@+id/k_i" />
        <include layout="@layout/key_letter" android:id="@+id/k_o" />
        <include layout="@layout/key_letter" android:id="@+id/k_p" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/key_height"
        android:orientation="horizontal"
        android:tag="row">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />
        <include layout="@layout/key_letter" android:id="@+id/k_a" />
        <include layout="@layout/key_letter" android:id="@+id/k_s" />
        <include layout="@layout/key_letter" android:id="@+id/k_d" />
        <include layout="@layout/key_letter" android:id="@+id/k_f" />
        <include layout="@layout/key_letter" android:id="@+id/k_g" />
        <include layout="@layout/key_letter" android:id="@+id/k_h" />
        <include layout="@layout/key_letter" android:id="@+id/k_j" />
        <include layout="@layout/key_letter" android:id="@+id/k_k" />
        <include layout="@layout/key_letter" android:id="@+id/k_l" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/key_height"
        android:orientation="horizontal"
        android:tag="row">

        <Button
            android:id="@+id/k_symbol"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/bg_key_special"
            android:tag="special"
            android:text="@string/key_symbol" />

        <include layout="@layout/key_letter" android:id="@+id/k_z" />
        <include layout="@layout/key_letter" android:id="@+id/k_x" />
        <include layout="@layout/key_letter" android:id="@+id/k_c" />
        <include layout="@layout/key_letter" android:id="@+id/k_v" />
        <include layout="@layout/key_letter" android:id="@+id/k_b" />
        <include layout="@layout/key_letter" android:id="@+id/k_n" />
        <include layout="@layout/key_letter" android:id="@+id/k_m" />

        <Button
            android:id="@+id/k_delete"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/bg_key_special"
            android:contentDescription="@string/cdesc_delete"
            android:tag="special"
            android:text="⌫" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/key_height"
        android:orientation="horizontal"
        android:tag="row">

        <Button
            android:id="@+id/k_lang"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/bg_key_special"
            android:tag="special"
            android:text="@string/key_lang"
            android:textSize="14sp" />

        <Button
            android:id="@+id/k_comma"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_key_special"
            android:tag="special"
            android:text="，" />

        <Button
            android:id="@+id/k_space"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4.4"
            android:background="@drawable/bg_key"
            android:text="@string/key_space"
            android:textSize="13sp" />

        <Button
            android:id="@+id/k_period"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_key_special"
            android:tag="special"
            android:text="。" />

        <Button
            android:id="@+id/k_enter"
            style="@style/KeyText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/bg_key_special"
            android:contentDescription="@string/cdesc_enter"
            android:tag="special"
            android:text="⏎" />
    </LinearLayout>
</LinearLayout>
