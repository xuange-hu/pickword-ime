<?xml version="1.0" encoding="utf-8"?>
<!-- 复习卡片：先给词，点击后显示释义，再自评认识/忘记（SM-2 调度） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/review_progress"
        style="@style/CardBody"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/review_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:minHeight="220dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/review_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_gloss"
            style="@style/CardBody"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="15sp"
            android:visibility="invisible" />

        <TextView
            style="@style/CardBody"
            android:layout_marginTop="16dp"
            android:text="@string/review_tap_show" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_missed"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/review_missed" />

        <Button
            android:id="@+id/btn_got"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/review_got" />
    </LinearLayout>

    <TextView
        android:id="@+id/review_done"
        style="@style/CardTitle"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/review_finished"
        android:visibility="gone" />
</LinearLayout>
